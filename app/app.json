{
  "expo": {
    "name": "CyberSid",
    "slug": "cybersid",
    "version": "1.0.6",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.cybersid.news",
      "versionCode": 7,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#05070F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#05070F"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563F5",
          "defaultChannel": "news"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# expo-gl's GLView is a TextureView, not an ExpoView, so Expo's own rules don't keep its\n# (Context, AppContext) constructor; without this the code shrinker removes it and the app crashes\n# when a spatial picture appears (test build 3/4 of 1.0.6).\n-keep class expo.modules.gl.** { *; }\n-keep class expo.modules.sensors.** { *; }\n"
          }
        }
      ],
      "expo-screen-orientation",
      [
        "expo-sensors",
        {
          "motionPermission": "CyberSid uses motion to give news pictures a gentle 3D effect as you tilt your phone."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "65ebff1f-c421-4fd0-a54e-870ce95a53e6"
      }
    },
    "owner": "cybershortappexpo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/65ebff1f-c421-4fd0-a54e-870ce95a53e6"
    }
  }
}
